<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\BEngine.Player.Hosts.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>BEngine.Player.AndroidHost</AssemblyName>
    <RootNamespace>BEngine.Player.Hosts.Android</RootNamespace>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AotAssemblies>true</AotAssemblies>
    <AndroidPackageFormat>aab</AndroidPackageFormat>
  </PropertyGroup>
  <ItemGroup Condition="'$(BEngineContentRoot)' != '' and '$(BEngineDataDirectoryName)' != ''">
    <AndroidAsset Include="$(BEngineContentRoot)\$(BEngineDataDirectoryName)\**\*">
      <Link>BEnginePayload\$(BEngineDataDirectoryName)\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
  </ItemGroup>
</Project>
