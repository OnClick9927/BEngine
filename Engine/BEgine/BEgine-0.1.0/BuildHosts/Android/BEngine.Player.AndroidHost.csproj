<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../BEngine.Player.Hosts.props" />
  <PropertyGroup>
    <BEngineBootstrapAssembly>true</BEngineBootstrapAssembly>
    <BEngineSolutionRole>Template</BEngineSolutionRole>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>BEngine.Player.AndroidHost</AssemblyName>
    <RootNamespace>BEngine.Player.Hosts.Android</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishTrimmed Condition="'$(RunAOTCompilation)' == 'true'">true</PublishTrimmed>
    <SuppressTrimAnalysisWarnings Condition="'$(RunAOTCompilation)' == 'true'">true</SuppressTrimAnalysisWarnings>
    <ILLinkTreatWarningsAsErrors Condition="'$(RunAOTCompilation)' == 'true'">false</ILLinkTreatWarningsAsErrors>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <!-- Content providers declare formats requiring seekable APK asset fd reads. -->
    <AndroidStoreUncompressedFileExtensions Condition="'$(BEngineUncompressedResourceExtensions)' != ''">$(AndroidStoreUncompressedFileExtensions);$(BEngineUncompressedResourceExtensions)</AndroidStoreUncompressedFileExtensions>
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidManifest Condition="'$(BEngineDevelopmentHost)' == 'true'">..\AndroidResources\DevelopmentAndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="BEngine.Android" RootMode="All" />
    <ProjectReference Include="../../../Android/Editor/Native/BEngine.Android.Native/BEngine.Android.Native.csproj"
                      Condition="Exists('../../../Android/Editor/Native/BEngine.Android.Native/BEngine.Android.Native.csproj')"
                      AdditionalProperties="BEnginePlatformRuntimeRoot=$(BEngineResolvedRuntimeRoot)" />
    <ProjectReference Include="../../BuildPlatform/BEngine.Android.Native/BEngine.Android.Native.csproj"
                      Condition="!Exists('../../../Android/Editor/Native/BEngine.Android.Native/BEngine.Android.Native.csproj') and Exists('../../BuildPlatform/BEngine.Android.Native/BEngine.Android.Native.csproj')"
                      AdditionalProperties="BEnginePlatformRuntimeRoot=$(BEngineResolvedRuntimeRoot)" />
  </ItemGroup>
  <ItemGroup Condition="'$(BEngineContentRoot)' != '' and '$(BEngineDataDirectoryName)' != ''">
    <AndroidAsset Include="$(BEngineContentRoot)\$(BEngineDataDirectoryName)\**\*">
      <Link>BEnginePayload\$(BEngineDataDirectoryName)\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
  </ItemGroup>
</Project>
