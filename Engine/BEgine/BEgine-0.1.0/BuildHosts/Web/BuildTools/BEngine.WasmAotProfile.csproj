<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="FrozenScriptStripVerifier.cs" />
    <Compile Include="WebAotHotProfile.cs" />
    <Compile Include="WebAotColdMethods.cs" />
    <PackageReference Include="Mono.Cecil" PrivateAssets="all" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" PrivateAssets="all" Condition="'$(ManagePackageVersionsCentrally)' != 'true'" />
  </ItemGroup>
</Project>
