<Project>
  <!-- Shared by source builds and the exported target SDK projects. -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <BEngineRuntimeAssembly>true</BEngineRuntimeAssembly>
    <_BEngineNativeTarget>$([System.String]::Copy('$(MSBuildProjectName)').Replace('BEngine.', '').Replace('.Native', ''))</_BEngineNativeTarget>
    <BEnginePlatformRuntimeRoot Condition="'$(BEnginePlatformRuntimeRoot)' == ''">$(MSBuildThisFileDirectory)../BuildRuntime/$(_BEngineNativeTarget)</BEnginePlatformRuntimeRoot>
  </PropertyGroup>
  <Target Name="ValidateNativePlatformRuntime" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(BEngineNativeSourceProject)' == '' or !Exists('$(BEngineNativeSourceProject)')">
    <Error Condition="!Exists('$(BEnginePlatformRuntimeRoot)/BEngine.$(_BEngineNativeTarget).dll')"
           Text="The $(_BEngineNativeTarget) runtime is missing from $(BEnginePlatformRuntimeRoot). Export the target runtime before compiling its native backend." />
  </Target>
</Project>
