// Entry point shared by the standard lit sprite pipelines.
void main()
{
    vec3 normal = uLighting[5].y > 0.5
        ? lightingNormal(sampleNormal(vTexCoord * uLighting[3].xy + uLighting[3].zw))
        : vec3(0.0, 0.0, 1.0);
    vec3 lighting = evaluateLighting(vPosition, normal);
    oColor = sampleTexture() * vec4(clamp(vColor.rgb * lighting, 0.0, 1.0), vColor.a);
}
