<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>../../../Development/Shared/Branding/BEngine.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BEngine.Launcher</RootNamespace>
    <AssemblyName>BEngine.Launcher</AssemblyName>
    <!-- Hub uses the Core editor contract without loading a GPU host. -->
    <SatelliteResourceLanguages>en;zh-Hans;zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../Development/Shared/Branding/BEngine.ico" LogicalName="BEngine.Launcher.BEngine.ico" />
    <EmbeddedResource Include="../../../Development/Shared/Branding/BEngine.Dark.ico" LogicalName="BEngine.Launcher.BEngine.Dark.ico" />
    <EmbeddedResource Include="../Editor/DocumentationAssets/**/*" LogicalName="BEngine.Launcher.DocumentationAssets/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Core/BEngine.Core.Editor/BEngine.Core.Editor.csproj" />
    <Compile Include="../../../Development/Shared/PackageCatalogTransport.cs" Link="Shared/PackageCatalogTransport.cs" />
    <Compile Include="../../../Development/Shared/WindowsBrandingIcons.cs" Link="Shared/WindowsBrandingIcons.cs" />
  </ItemGroup>
</Project>
