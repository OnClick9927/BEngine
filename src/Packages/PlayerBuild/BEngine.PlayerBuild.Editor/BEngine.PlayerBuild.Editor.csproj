<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>BEngine.PlayerBuild.Editor</AssemblyName>
    <RootNamespace>BEngine.Editor</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <BEnginePackageExportOwner>true</BEnginePackageExportOwner>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Core/BEngine.Editor/BEngine.Editor.csproj" />
    <ProjectReference Include="../../AssetBundles/BEngine.AssetBundles.Editor/BEngine.AssetBundles.Editor.csproj" />
    <ProjectReference Include="../../Player/BEngine.Player.Editor/BEngine.Player.Editor.csproj" />
    <ProjectReference Include="../../UIElements/BEngine.UIElements/BEngine.UIElements.csproj" />
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="Veldrid.SPIRV" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" GeneratePathProperty="true" PrivateAssets="all" />
    <Content Include="$(PkgMicrosoft_NET_ILLink_Tasks)/tools/net/**/*">
      <Link>BuildTools/ILLink/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="ExportPlayerStrippingTools" AfterTargets="ExportBEngineSourcePackage"
          Condition="'$(BEnginePackageExportOwner)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_PlayerILLinkFile Include="$(PkgMicrosoft_NET_ILLink_Tasks)/tools/net/**/*" />
    </ItemGroup>
    <Error Condition="!Exists('$(PkgMicrosoft_NET_ILLink_Tasks)/tools/net/illink.dll')"
           Text="PlayerBuild ILLink tools were not restored. Restore and build the PlayerBuild package before exporting." />
    <Copy SourceFiles="@(_PlayerILLinkFile)"
          DestinationFiles="@(_PlayerILLinkFile->'$(_BEnginePackageOutput)/Editor/BuildTools/ILLink/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
