<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BEngine.Player</RootNamespace>
    <AssemblyName>BEngine.Player</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(BEnginePlayerPlatform)' != '' and '$(BEnginePlayerPlatform)' != 'Desktop'">$(DefineConstants);BENGINE_PLAYER_PORTABLE</DefineConstants>
    <BEngineRuntimeAssembly>true</BEngineRuntimeAssembly>
    <BEnginePackageExportOwner>true</BEnginePackageExportOwner>
    <BEnginePlayerPlatform Condition="'$(BEnginePlayerPlatform)' == ''">Desktop</BEnginePlayerPlatform>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../AssetBundles/BEngine.AssetBundles/BEngine.AssetBundles.csproj" />
    <ProjectReference Include="../../HotUpdate/BEngine.HotUpdate/BEngine.HotUpdate.csproj" />
    <ProjectReference Include="../../Diagnostics/BEngine.Diagnostics/BEngine.Diagnostics.csproj" />
    <ProjectReference Include="../../../Core/BEngine/BEngine.csproj" />
    <ProjectReference Include="../../../Platform/BEngine.Platform.DotNet/BEngine.Platform.DotNet.csproj" />
    <ProjectReference Include="../../../Platform/BEngine.Windows/BEngine.Windows.csproj" Condition="'$(BEnginePlayerPlatform)' == 'Desktop'" />
    <ProjectReference Include="../../../Platform/BEngine.Linux/BEngine.Linux.csproj" Condition="'$(BEnginePlayerPlatform)' == 'Desktop'" />
    <ProjectReference Include="../../../Platform/BEngine.macOS/BEngine.macOS.csproj" Condition="'$(BEnginePlayerPlatform)' == 'Desktop'" />
    <ProjectReference Include="../../../Platform/BEngine.$(BEnginePlayerPlatform)/BEngine.$(BEnginePlayerPlatform).csproj" Condition="'$(BEnginePlayerPlatform)' != 'Desktop'" />
    <Compile Remove="Application/Program.cs" Condition="'$(BEnginePlayerPlatform)' != 'Desktop'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="YamlDotNet" />
    <ProjectReference Include="../../../Platform/BEngine.Platform.Desktop/BEngine.Platform.Desktop.csproj" Condition="'$(BEnginePlayerPlatform)' == 'Desktop'" />
    <PackageReference Include="Silk.NET.Windowing" Condition="'$(BEnginePlayerPlatform)' == 'Desktop'" />
  </ItemGroup>
</Project>
