<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>BEngine</RootNamespace>
    <AssemblyName>BEngine</AssemblyName>
    <BEngineRuntimeAssembly>true</BEngineRuntimeAssembly>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="StbImageSharp" />
    <PackageReference Include="BCnEncoder.Net" />
    <PackageReference Include="AssetRipper.TextureDecoder" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="bin/**/*.cs;obj/**/*.cs" />
  </ItemGroup>
</Project>
