<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmBuildNative>false</WasmBuildNative><PublishTrimmed>false</PublishTrimmed>
    <WasmMainHTMLPath>index.html</WasmMainHTMLPath><WasmMainJSPath>main.js</WasmMainJSPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(EngineBinaries)/BEngine.Core.dll" />

    <Reference Include="$(EngineBinaries)/BEngine.Player.dll" />
    <Reference Include="$(EngineBinaries)/BEngine.Platform.Contracts.dll" /><Reference Include="$(EngineBinaries)/BEngine.Platform.DotNet.dll" />
    <Reference Include="$(EngineBinaries)/BEngine.Web.dll" />
    <Reference Include="$(EngineBinaries)/YamlDotNet.dll" /><Reference Include="$(EngineBinaries)/Microsoft.Extensions.DependencyInjection*.dll" />
    <Content Include="$(FixtureImage)" Link="wwwroot/ManagedSessionFixture.dll" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="index.html;main.js" Link="wwwroot/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PlatformResources)/platform.js;$(PlatformResources)/text.js;$(PlatformResources)/video.js" Link="wwwroot/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
