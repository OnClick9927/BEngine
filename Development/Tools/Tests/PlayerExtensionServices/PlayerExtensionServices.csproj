<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>
  <ItemGroup>
    <!-- Deliberately not a friend assembly: exercise the public extension contract. -->
    <Reference Include="$(EngineBinaries)/BEngine.Core*.dll" />
    <Reference Include="$(EngineBinaries)/BEngine.Platform.DotNet.dll" />
    <Reference Include="$(EngineBinaries)/BEngine.Player.dll" />
    <Reference Include="$(EngineBinaries)/Microsoft.Extensions.DependencyInjection*.dll" />
  </ItemGroup>
</Project>
