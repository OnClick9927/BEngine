<Project>
  <PropertyGroup>
    <!-- Keep IDE builds and design-time restore outside the plugin sources too. -->
    <BEnginePluginWorkspace>$([System.IO.Path]::GetFullPath('$(_DirectoryBuildPropsBasePath)/../..'))</BEnginePluginWorkspace>
    <BaseOutputPath>$(BEnginePluginWorkspace)/Temp/Plugin/Build/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(BEnginePluginWorkspace)/Temp/Plugin/Build/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
