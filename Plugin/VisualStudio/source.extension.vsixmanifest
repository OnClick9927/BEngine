<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="BEngine.VisualStudio.9b48e068-a0d0-4748-8e7e-c66a3a628241" Version="1.0.0" Language="en-US" Publisher="BEngine" />
    <DisplayName>BEngine Tools for Visual Studio</DisplayName>
    <Description xml:space="preserve">Attach to BEngine Editor in one click, synchronize C# projects and use Visual Studio IntelliSense for engine, package and game code.</Description>
    <MoreInfo>https://onclick9927.github.io/BEngine/</MoreInfo>
    <Tags>BEngine,C#,Debugging,Game Development</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,)"><ProductArchitecture>amd64</ProductArchitecture></InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName=".NET Framework" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
    <Prerequisite Id="Microsoft.VisualStudio.Component.ManagedDesktop.Core" Version="[17.0,)" DisplayName=".NET desktop development tools" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
